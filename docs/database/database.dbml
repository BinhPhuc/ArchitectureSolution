Project flash_sale_ecommerce {
  database_type: 'MySQL'
}

Enum role_name {
  SELLER
  CUSTOMER
}

Enum order_status {
  PENDING
  PREPARED
  SHIPPED
  DELIVERED
  CANCELED
}

Table users {
  id varchar(36) [pk, note: 'UUID generated by JPA']
  email varchar(255) [not null, unique]
  username varchar(255) [not null, unique, note: 'JWT subject']
  password_hash varchar(255) [not null, note: 'BCrypt']
  displayed_name varchar(255)
  role role_name [not null, note: 'One role per user']
  refresh_token varchar(255) [unique, note: 'Latest refresh JWT, rotated on every login/refresh']
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table sellers {
  user_id varchar(36) [pk, ref: - users.id, note: 'Same value as users.id']
  shop_name varchar(255) [not null]
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table customers {
  user_id varchar(36) [pk, ref: - users.id, note: 'Same value as users.id']
  phone varchar(255)
  shipping_address varchar(255)
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table files {
  id varchar(36) [pk]
  object_key varchar(1024) [not null, note: '<seller_id>/<uuid> inside bucket item-images']
  original_filename varchar(255) [not null]
  content_type varchar(255) [not null, note: 'image/jpeg or image/png']
  size_bytes bigint [not null]
  owner_id varchar(36) [not null, ref: > sellers.user_id]
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table campaigns {
  id varchar(36) [pk]
  name varchar(255)
  description text
  start_at datetime [not null, note: 'Notification is scheduled at this instant']
  end_at datetime [not null, note: 'Must be after start_at']
  seller_id varchar(36) [ref: > sellers.user_id]
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table orders {
  id varchar(36) [pk]
  customer_id varchar(36) [ref: > customers.user_id]
  total_amount decimal(19,2) [note: 'Sum of price * quantity at order time']
  status order_status [note: 'Only PENDING is assigned by the current API']
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table campaign_items {
  id varchar(36) [pk]
  campaign_id varchar(36) [ref: > campaigns.id]
  name varchar(255)
  thumbnail_id varchar(36) [ref: > files.id, note: 'Optional image uploaded by the seller']
  price decimal(19,2) [note: 'Price used when an order is created']
  stock bigint [not null, note: 'Decremented on each order']
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

Table order_items {
  id varchar(36) [pk]
  order_id varchar(36) [ref: > orders.id]
  campaign_item_id varchar(36) [ref: > campaign_items.id]
  quantity int [not null]
  created_at datetime [not null]
  created_by varchar(255) [not null]
  last_modified_at datetime
  last_modified_by varchar(255)
}

TableGroup identity {
  users
  sellers
  customers
}

TableGroup catalog {
  files
  campaigns
  campaign_items
}

TableGroup ordering {
  orders
  order_items
}